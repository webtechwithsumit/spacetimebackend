PORT=3002
MONGODB_URI=mongodb://username:password@host:27017/spacetime-db?authSource=admin
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Analytics Plugin (optional paid module)
# Separate database for analytics events
ANALYTICS_ENABLED=false
ANALYTICS_MONGODB_URI=mongodb://username:password@host:27017/spacetime-analytics?authSource=admin

# Comma-separated frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://spacetime.com.co,https://www.spacetime.com.co

# Optional: public API URL for Scalar docs (/reference)
# BASE_URL=https://api.yourdomain.com
